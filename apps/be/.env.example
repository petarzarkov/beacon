# Every variable has a default, so the panel boots with no .env at all - except
# that with no AGENT_ENROLMENT_TOKEN, no agent can enrol. See config.ts.

PORT=3000
LOG_LEVEL=info
# The console origin in development. In production it is served from this origin.
CORS_ORIGIN=http://localhost:5173
# Believe x-forwarded-for. Only behind a trusted proxy - a deployment grant is
# bound to the source address, so a wrong answer here breaks enrolment.
TRUST_PROXY=false
# A file, not :memory:. The fleet is the state; losing it re-enrols every host.
DATABASE_FILE=./data/panel.sqlite
# better-auth signs sessions with this, and the panel signs deployment grants.
AUTH_SECRET=change-me-to-at-least-32-characters-long
SCHEDULE_TZ=UTC

# The fleet-wide credential a host presents once to enrol. Empty disables
# enrolment entirely. Generate one: openssl rand -hex 32
AGENT_ENROLMENT_TOKEN=
# Where `bun run build:agent` publishes the binary + manifest.
AGENT_RELEASE_DIR=./data/agent
# The report cadence the panel hands agents.
AGENT_REPORT_INTERVAL_MS=30000
# Silence longer than this and the console stops calling an agent connected.
# Defaults to 3x the report interval when unset.
# AGENT_OFFLINE_AFTER_MS=90000
# How long a queued command stays deliverable before it expires.
AGENT_COMMAND_TTL_MS=3600000
