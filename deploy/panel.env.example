# Copy to /etc/dunxon-panel.env (chmod 0600), fill in the secrets, and point the
# systemd unit's EnvironmentFile at it. Every agent reaches the panel from the
# public internet, so these are the settings that make that safe.

# The public origin operators and agents use. Better Auth signs cookies and
# checks the sign-in Origin against this - a real domain here, never localhost,
# or every browser sign-in is rejected as CSRF.
APP_URL=https://panel.example.com

# Believe X-Forwarded-For, because a reverse proxy terminates TLS in front. This
# is not optional here: a deployment grant is bound to the agent's source
# address, and with this off every agent looks like the proxy and no grant works.
TRUST_PROXY=true

# The console is same-origin with the panel, so this only matters if you serve it
# from a different origin. Set it to the public origin to be explicit.
CORS_ORIGIN=https://panel.example.com

# Persist the fleet. An absolute path outside the checkout, so a redeploy that
# replaces the code does not wipe who is enrolled.
DATABASE_FILE=/var/lib/dunxon/panel.sqlite

# The published agent binary + manifest. Written by `bun run build:agent`.
AGENT_RELEASE_DIR=/var/lib/dunxon/agent

# Secrets. Generate each with: openssl rand -hex 32
AUTH_SECRET=
AGENT_ENROLMENT_TOKEN=

# The port the reverse proxy forwards to. The panel binds all interfaces, so a
# firewall should keep this port off the public internet - only the proxy reaches it.
PORT=3000
LOG_LEVEL=info

# Self-propagation is paused fleet-wide until an admin arms it in the console.
# Leave this false; it only seeds the very first boot.
AGENT_PROPAGATION_ALLOWED=false
